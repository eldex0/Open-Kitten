            VALUE "InternalName", "OpenKitten\0"
            VALUE "LegalCopyright", "GPL-3.0-or-later contributors\0"
            VALUE "OriginalFilename", "OpenKitten.exe\0"
            VALUE "ProductName", "Open Kitten\0"
            VALUE "ProductVersion", "2.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040c, 1200
    END
END
